  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production && node ./scripts/gh-pages-before-add.js",
    "serve:ci": "npx local-web-server --port 4200 --directory ./dist --spa timer-5/404.html",
    "e2e": "playwright test e2e/fixtures",
    "e2e:update-snapshots": "playwright test e2e/fixtures --update-snapshots",
    "e2e:ci": "playwright test e2e/fixtures",
    "e2e:linux": "node scripts/e2e-linux.js",
    "e2e:linux:update-snapshots": "node scripts/e2e-linux.js --update-snapshots",
    "e2e:all": "npm run e2e && npm run e2e:linux",
    "deploy": "gh-pages --nojekyll --dotfiles --dist dist/timer-5",
    "generate-screenshots": "node ./scripts/generate-screenshots.ts"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^22.3.0-next.4",
    "@angular/cdk": "^22.3.0-next.5",
    "@angular/common": "^22.3.0-next.4",
    "@angular/compiler": "^22.3.0-next.4",
    "@angular/core": "^22.3.0-next.4",
    "@angular/forms": "^22.3.0-next.4",
    "@angular/material": "^22.3.0-next.5",
    "@angular/platform-browser": "^22.3.0-next.4",
    "@angular/router": "^22.3.0-next.4",
    "@angular/service-worker": "^22.3.0-next.4",
    "angular2-hotkeys": "^16.0.1",
    "date-fns": "^4.4.0",
    "immer": "^11.1.8",
    "nanoid": "^5.1.11",
    "rxjs": "^7.8.2",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0-next.5",
    "@angular/cli": "^22.3.0-next.5",
    "@angular/compiler-cli": "^22.3.0-next.4",
    "@angular/language-service": "^22.3.0-next.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "baseline-browser-mapping": "^2.10.36",
    "gh-pages": "^6.3.0",
    "local-web-server": "^5.4.0",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
